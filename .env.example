# ---- never commit real values. Sandbox credentials only; there is no production mode.
APP_BASE_URL=http://localhost:3000
PORT=3000
# Empty locally => embedded Postgres (PGlite, in-memory). Set on Render (Postgres connection string).
DATABASE_URL=

# ---- PayPal Sandbox (server-side only)
LIVE_PAYPAL=false            # false => simulated REPLAY adapter, no credentials needed
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-me
PAYPAL_CLIENT_SECRET=replace-me
PAYPAL_WEBHOOK_ID=replace-me # needs the public (Render) URL
PAYPAL_REDIRECT_FALLBACK=false
KILL_SWITCH=false            # disables live PayPal actions; replay stays available

# ---- Intent signing (Ed25519). Generate with: npm run gen:key
# Required on Render. If unset the server uses an ephemeral key (contracts will not verify after a restart).
INTENT_SIGNING_KEY=
INTENT_TTL_MIN=60

# ---- AI proposal service (optional; falls back to a labelled deterministic agent)
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=20000
AI_MAX_CALLS_PER_HOUR=120    # hard cap on model calls; beyond it the deterministic agent is used
REPLAY_MODE=true             # true => never call the model

# ---- Operator controls
INTERNAL_ACTION_KEY=         # when set: fixtures need header x-internal-key; >25 simulated shoppers per request need it
SIM_MAX_ACTIVE=600
SIM_RATE_LIMIT=600
